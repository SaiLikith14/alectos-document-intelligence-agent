FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY requirements.txt requirements-gateway.txt ./
RUN pip install --no-cache-dir -r requirements-gateway.txt
COPY . .
# Apply the gateway schema, then serve. Migration is idempotent, so restarts are safe.
CMD python -m gateway.migrate && exec uvicorn gateway.main:create_gateway --factory --host 0.0.0.0 --port ${PORT:-8001}

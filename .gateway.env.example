# Copy to .gateway.env. Values below are placeholders, not credentials.
# Use the existing PostgreSQL database or a dedicated gateway PostgreSQL database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
BACKEND_URL=https://YOUR-EXISTING-BACKEND-HOST
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Set the same secret on the backend service. Never put it in VITE_* variables.
BACKEND_GATEWAY_SECRET=REPLACE_WITH_A_NEW_RANDOM_SECRET

# Firebase example: replace YOUR_FIREBASE_PROJECT_ID in both settings.
AUTH_ISSUER=https://securetoken.google.com/YOUR_FIREBASE_PROJECT_ID
AUTH_AUDIENCE=YOUR_FIREBASE_PROJECT_ID
AUTH_JWKS_URL=https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com

# Comma-separated verified token subject IDs (Firebase UIDs), never email addresses.
ADMIN_SUBJECTS=
BLOCKED_SUBJECTS=
# Login and ownership are always enforced. Only the trial counter is disabled.
TRIAL_ENFORCEMENT_ENABLED=false
TRIAL_REQUESTS_PER_AGENT=1
GATEWAY_MAX_UPLOAD_MB=20
GATEWAY_MAX_DOCUMENTS_PER_USER=10
GATEWAY_TIMEOUT_SECONDS=180
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://YOUR-FRONTEND-HOST
